#cloud-config
package_update: true
package_upgrade: true

apt:
  sources:
    docker.list:
      source: "deb [arch=amd64 signed-by=$KEY_FILE] https://download.docker.com/linux/ubuntu $RELEASE stable"
      keyid: 9DC858229FC7DD38854AE2D88D81803C0EBFCD88

packages:
  - ca-certificates
  - curl
  - gnupg
  - lsb-release
  - docker-ce
  - docker-ce-cli
  - containerd.io
  - docker-buildx-plugin
  - docker-compose-plugin

write_files:
  - path: /opt/gep/docker-compose.yml
    permissions: "0644"
    owner: root:root
    encoding: b64
    content: ${compose_b64}

  - path: /etc/systemd/system/gep-stack.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=GEP-003 docker compose stack
      Requires=docker.service
      After=docker.service network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      WorkingDirectory=/opt/gep
      ExecStartPre=/usr/bin/docker compose pull
      ExecStart=/usr/bin/docker compose up -d
      ExecStop=/usr/bin/docker compose down

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl enable --now docker
  - usermod -aG docker ${admin_username}
  - systemctl daemon-reload
  - systemctl enable --now gep-stack.service

final_message: "GEP-003 stack bootstrap finished after $UPTIME seconds."
