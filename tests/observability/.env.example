# Observability test suite environment.
# Copy to .env (or set in shell) before running `npm test`.

IAM_URL=http://localhost:3001
SUPPLIER_URL=http://localhost:3002
PO_URL=http://localhost:3003

# Observability stack (compose-defined ports)
COLLECTOR_METRICS_URL=http://localhost:8889/metrics
COLLECTOR_HEALTH_URL=http://localhost:13133/
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
GRAFANA_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Seed user credentials (match back-end/.env)
ADMIN_EMAIL=admin@demo.local
BUYER_EMAIL=buyer@demo.local
SEED_PASSWORD=Passw0rd!

# How long to wait for the stack to come up
WAIT_FOR_STACK_TIMEOUT=120000
