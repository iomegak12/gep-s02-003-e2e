# Shared test environment (consumed by both UI Playwright specs and API Jest tests).
# Q1 — UI base URL (configurable)
WEB_BASE_URL=http://localhost:8080

# Q2 — path to data-driven test data (resolved relative to this file)
TEST_DATA_FILE=./data.txt

# ---- API test config (shared) ----
IAM_URL=http://localhost:3001
SUPPLIER_URL=http://localhost:3002
PO_URL=http://localhost:3003
WAIT_FOR_STACK_TIMEOUT=60000

ADMIN_EMAIL=admin@demo.local
BUYER_EMAIL=buyer@demo.local
APPROVER_HI_EMAIL=approver-hi@demo.local
APPROVER_LO_EMAIL=approver-lo@demo.local
SEED_PASSWORD=Passw0rd!
PO_APPROVAL_THRESHOLD=100000

# ---- UI action timing (randomized between min and max, milliseconds) ----
UI_ACTION_DELAY_MIN_MS=300
UI_ACTION_DELAY_MAX_MS=1000

# ---- Fixed UI test targets ----
SUPPLIER_SEARCH_QUERY=EuroTrans
SUPPLIER_EXPECTED_NAME=EuroTrans Logistics
PO_SEARCH_QUERY=PO-2026-00061
PO_EXPECTED_NUMBER=PO-2026-00061
PO_EXPECTED_SUPPLIER=EuroTrans Logistics
