# Purchase Order service environment variables.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gep_po
PORT=3003

# JWT verification (must match IAM)
JWT_SECRET=please-change-me-in-production

# IAM service URL — used for supplier validation and internal notification fanout.
AUTH_SERVICE_URL=http://localhost:3001
SUPPLIER_SERVICE_URL=http://localhost:3002/api/v1

# Default approval threshold (auto-approved below this amount)
DEFAULT_APPROVAL_THRESHOLD=100000

# Shared secret used to call IAM's internal notifications endpoint.
# MUST match the same env var on the IAM service.
INTERNAL_SERVICE_TOKEN=
