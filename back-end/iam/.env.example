# IAM service environment variables
# Copy to .env and fill in the values appropriate to your environment.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gep_iam

# JWT signing
JWT_SECRET=please-change-me-in-production
ACCESS_TOKEN_TTL_SECONDS=900

# Server
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Bootstrap admin (created on first launch if it doesn't exist)
BOOTSTRAP_ADMIN_EMAIL=admin@demo.local
BOOTSTRAP_ADMIN_PASSWORD=Passw0rd!

# Shared secret used by other services (PO, etc.) for the internal notifications endpoint.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
INTERNAL_SERVICE_TOKEN=

# Firebase service account for FCM push.
# Option A: path to the downloaded JSON (default: ./firebase-service-account.json).
FIREBASE_SERVICE_ACCOUNT_PATH=
# Option B: inline JSON (useful for container/CI secrets). If set, takes precedence.
FIREBASE_SERVICE_ACCOUNT_JSON=
